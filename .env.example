APP_ORIGIN=http://127.0.0.1:53860
# Подтверждённый боевой URL: https://ads.mts.ru/conf
# Значение используется и при сборке клиентской части, и Node-сервером SPA.
# Для боевого окружения: APP_ORIGIN=https://ads.mts.ru и PUBLIC_BASE_PATH=/conf/
PUBLIC_BASE_PATH=/
# SPA и API запускаются отдельными процессами: `npm start` и `npm run server`.
SPA_PORT=53860
API_PORT=53861
# Для локального запуска и работы через обратный прокси оставьте значение по умолчанию.
# Используйте 0.0.0.0 только если этого требует среда размещения.
SERVER_HOST=127.0.0.1

# Включайте только за настроенным доверенным прокси-сервером.
TRUST_LOCAL_PROXY=false

# Серверный URL импорта Sendsay. Оставьте пустым, пока в Sendsay не создан новый
# webhook для подтверждённых контактов с JSON-контрактом из README.
SENDSAY_IMPORT_WEBHOOK_URL=

# Публичный адрес или префикс серверной части, встраиваемый при сборке.
# Клиент всегда добавляет /api/register. Оставьте пустым, если SPA и API
# доступны с одного источника.
API_BASE_URL=http://127.0.0.1:53861

# Публичная конфигурация Sendsay Form API. Эти идентификаторы встраиваются
# в браузерную сборку; не помещайте сюда API-ключ Sendsay и другие секреты.
SENDSAY_ACCOUNT=mtsmarketolog
SENDSAY_FORM_ID=24
SENDSAY_FIELD_NAME=q1
SENDSAY_FIELD_PHONE=q2
SENDSAY_FIELD_COMPANY=q3
SENDSAY_FIELD_ROLE=q4

# Необязательные скрытые поля. Код каждого поля задавайте вместе со значением.
# Дата и время Sendsay указываются по Москве в формате YYYY-MM-DD hh:mm:ss.
SENDSAY_FIELD_EVENT_DATETIME=q5
SENDSAY_EVENT_DATETIME="2026-11-19 17:00:00"
SENDSAY_FIELD_EVENT_ID=
SENDSAY_EVENT_ID=

# Необязательная отдельная тестовая форма. В текущей конфигурации не используется.
SENDSAY_TEST_FORM_ID=
SENDSAY_USE_TEST_FORM=false
