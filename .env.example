EMAIL_API_KEY=
EMAIL_FROM=
APP_ORIGIN=http://127.0.0.1:53860
PORT=53860
# Keep the default for a local/reverse-proxy deployment. Use 0.0.0.0 only when the host requires it.
SERVER_HOST=127.0.0.1

# Production: keep test mode off. See HANDOFF.md.
EMAIL_TEST_MODE=false
EMAIL_TEST_RECIPIENT=
TRUST_LOCAL_PROXY=false

# Public Sendsay Form API configuration. These identifiers are embedded in the
# browser bundle; never put a Sendsay API key here or in any frontend variable.
SENDSAY_ACCOUNT=
SENDSAY_FORM_ID=
SENDSAY_FIELD_NAME=
SENDSAY_FIELD_PHONE=
SENDSAY_FIELD_COMPANY=
SENDSAY_FIELD_ROLE=

# Optional hidden fields. Configure each code together with its value.
# Sendsay datetime uses Moscow time: YYYY-MM-DD hh:mm:ss.
SENDSAY_FIELD_EVENT_DATETIME=
# Once the field code is known, use the confirmed Moscow event time:
# SENDSAY_EVENT_DATETIME=2026-11-19 17:00:00
SENDSAY_EVENT_DATETIME=
SENDSAY_FIELD_EVENT_ID=
SENDSAY_EVENT_ID=

# Safe integration testing: create a separate form/list and opt into it at build time.
SENDSAY_TEST_FORM_ID=
SENDSAY_USE_TEST_FORM=false
