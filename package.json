{
  "name": "mts-ads-conference",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "images:sequence": "node scripts/optimize-images.mjs --rebuild-sequence",
    "images:mobile": "node scripts/optimize-mobile-frames.mjs",
    "images:verify": "node scripts/optimize-images.mjs --verify",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "start": "node server/start-spa.mjs",
    "server": "node server/start-api.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.0",
    "postcss": "^8.5.0",
    "prettier": "^3.9.8",
    "sharp": "^0.34.5"
  }
}
